# VS Code local state. The C/C++ extension's browse database grows to >1 GB,
# which GitHub rejects outright — never commit this directory.
.vscode/

# Python
__pycache__/
*.pyc

# The repo root holds only site files: index.html, README.md, resume.pdf.
# Raw captures and working documents do not belong here — web-ready media goes
# under assets/, and source footage stays with the project it came from.
/*.mp4
/*.mov
/*.gif
/*.docx
